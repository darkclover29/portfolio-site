# EmailJS credentials — copy this file to .env.local and fill in your values.
# Get these from https://www.emailjs.com/docs/introduction/
# These are public-by-design (used client-side) — safe to commit the .example file only.
VITE_EMAILJS_SERVICE=service_xxxxxxx
VITE_EMAILJS_TEMPLATE=template_xxxxxxx
VITE_EMAILJS_KEY=your_public_key_here
